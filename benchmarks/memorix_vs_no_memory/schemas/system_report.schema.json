{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memorix.system-report.schema.json",
  "title": "memoriX system instrumentation report",
  "type": "object",
  "required": [
    "schema_version",
    "instrumentation_version",
    "command",
    "working_directory",
    "duration_ms",
    "timed_out",
    "exit_code",
    "sample_count",
    "peak_rss_bytes",
    "mean_cpu_percent",
    "stdout_sha256",
    "stderr_sha256",
    "tracked_directories"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "instrumentation_version": {"const": "34.1"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "duration_ms": {"type": "number", "minimum": 0},
    "sample_count": {"type": "integer", "minimum": 1},
    "peak_rss_bytes": {"type": "integer", "minimum": 0},
    "mean_cpu_percent": {"type": "number", "minimum": 0},
    "tracked_directories": {"type": "object"}
  },
  "additionalProperties": true
}
