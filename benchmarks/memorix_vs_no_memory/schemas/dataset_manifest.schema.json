{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memorix://benchmark/dataset-manifest.schema.json",
  "title": "memoriX benchmark dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "benchmark_id", "dataset_id", "generator_version",
    "size", "seed", "record_count", "query_count", "family_counts",
    "records_sha256", "queries_sha256", "request_sha256",
    "records_file", "queries_file"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"const": "memorix_vs_no_memory"},
    "dataset_id": {"type": "string", "minLength": 3},
    "generator_version": {"type": "string"},
    "size": {"enum": ["tiny", "small", "medium", "large", "stress", "extreme"]},
    "seed": {"type": "integer", "minimum": 0},
    "record_count": {"type": "integer", "minimum": 1},
    "query_count": {"type": "integer", "minimum": 0},
    "family_counts": {"type": "object"},
    "records_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "queries_sha256": {"type": ["string", "null"]},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "records_file": {"type": "string"},
    "queries_file": {"type": ["string", "null"]}
  }
}
