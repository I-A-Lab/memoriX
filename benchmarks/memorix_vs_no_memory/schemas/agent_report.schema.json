{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "memoriX agent multisession report",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_version",
    "suite",
    "mode",
    "backend",
    "dataset_id",
    "metrics",
    "episode_results_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_version": {
      "const": "35.1"
    },
    "suite": {
      "const": "agent_multisession"
    },
    "mode": {
      "enum": [
        "no_memory",
        "memorix_core"
      ]
    },
    "backend": {
      "enum": [
        "lexical",
        "memorix"
      ]
    },
    "dataset_id": {
      "type": "string"
    },
    "metrics": {
      "type": "object"
    },
    "episode_results_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
