{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "api": "http://localhost:11434/v1",
      "env": [],
      "models": {
        "qwen2.5:3b": {
          "name": "Qwen 2.5 3B",
          "id": "qwen2.5:3b",
          "context": 32768,
          "temperature": false,
          "tool_call": true
        },
        "qwen2.5:7b": {
          "name": "Qwen 2.5 7B",
          "id": "qwen2.5:7b",
          "context": 32768,
          "temperature": false,
          "tool_call": true
        },
        "gemma2:2b": {
          "name": "Gemma 2 2B",
          "id": "gemma2:2b",
          "context": 8192,
          "temperature": false,
          "tool_call": true
        },
        "llama3.2:latest": {
          "name": "Llama 3.2",
          "id": "llama3.2:latest",
          "context": 8192,
          "temperature": false,
          "tool_call": true
        }
      }
    }
  },
  "permission": {
    "memory_store": "allow",
    "memory_candidate_validate": "ask",
    "memory_candidate_reject": "ask",
    "memory_consolidate": "ask",
    "memory_nightly_run": "ask",
    "memory_capacity_status": "allow",
    "memory_capacity_plan": "allow",
    "memory_capacity_prune": "ask",
    "memory_pressure_status": "allow",
    "memory_pressure_inspect": "allow",
    "retention_ranking_status": "allow",
    "retention_ranking_inspect": "allow",
    "adaptive_routing_plan": "allow",
    "policy_search": "allow",
    "policy_lifecycle": "ask",
    "topic_blocks": "ask",
    "consolidation": "ask",
    "observability": "ask",
    "project_archive_record": "allow",
    "project_snapshot_rebuild": "ask",
  },
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
